{
  "name": "infinite-interaction",
  "version": "0.0.4",
  "description": "Browser interactive video studio",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build --webpack",
    "start": "next start -H 127.0.0.1 -p 3100",
    "lint": "eslint app server scripts shared __tests__/unit __tests__/integration i18n next.config.mjs vitest.config.mts vitest.integration.config.mts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:integration": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run --config vitest.integration.config.mts",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "user:create": "node --env-file-if-exists=.env.local --import tsx scripts/create-user.ts",
    "models:seed": "node --env-file-if-exists=.env.local --import tsx scripts/seed-model-connections.ts",
    "models:verify-credentials": "node --env-file-if-exists=.env.local --import tsx scripts/verify-model-credentials.ts",
    "verify:protected": "python3 ../scripts/protected-folders.py",
    "verify:recovery": "node --env-file-if-exists=.env.local --import tsx scripts/verify-recovery.ts",
    "verify:client-secrets": "node --env-file-if-exists=.env.local --import tsx scripts/verify-client-secrets.ts",
    "worker:media": "node --env-file-if-exists=.env.local --import tsx scripts/media-worker.ts",
    "worker:publish": "node --env-file-if-exists=.env.local --import tsx scripts/publish-worker.ts",
    "worker:generation": "node --env-file-if-exists=.env.local --import tsx scripts/generation-worker.ts",
    "models:operations": "node --env-file-if-exists=.env.local --import tsx scripts/model-operations.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1133.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@swc/helpers": "0.5.23",
    "@types/dagre": "^0.7.53",
    "@xyflow/react": "^12.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.2",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.564.0",
    "next": "16.2.7",
    "next-intl": "^4.13.0",
    "pg": "^8.23.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "swr": "^2.4.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tldraw": "^5.0.1",
    "uuid": "^13.0.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.1.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^11.0.0",
    "@vitest/ui": "^1.6.0",
    "autoprefixer": "^10.0.0",
    "dotenv": "^17.3.1",
    "electron": "^42.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.7",
    "happy-dom": "^14.12.3",
    "postcss": "^8.0.0",
    "rcedit": "^5.0.2",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.23.13",
    "typescript": "^5.0.0",
    "vitest": "^1.6.0"
  }
}
