# false: builtins only; true: personal configurations. Restart after changing.
MODEL_CONFIGURATION_ENABLED=false
DATABASE_URL=postgresql://interaction:interaction_local_only@127.0.0.1:55432/interaction
APP_ORIGIN=http://127.0.0.1:3100
# Local development only. Use a unique database password, HTTPS origin and private storage in deployment.

S3_ENDPOINT=http://127.0.0.1:53900
S3_REGION=garage
S3_BUCKET=interaction-private
S3_ACCESS_KEY_ID=GK33333333333333333333333333333333
S3_SECRET_ACCESS_KEY=2222222222222222222222222222222222222222222222222222222222222222
MEDIA_MAX_BYTES=104857600
MEDIA_MAX_SECONDS=600

# Model configuration: deployment-managed, server-only; never use NEXT_PUBLIC_ for these.
MODEL_ALLOWED_ORIGINS_JSON=[]
MODEL_CREDENTIAL_ACTIVE_KEY=
MODEL_CREDENTIAL_KEYS_JSON={}

# Video generation stays unavailable until an account-specific, dated price contract,
# a project budget and a concurrency limit are configured on the server.
# VIDEO_PRICE_CONTRACT_JSON uses {id,currency:"CNY",source,reviewedAt,validUntil,
#   entries:[{mode:"text",duration,resolution,ratio,maxChargeCents}]}.
# Each supported parameter combination needs its own reviewed ceiling in CNY cents.
# VIDEO_PRICE_CONTRACT_JSON=
# VIDEO_PROJECT_BUDGET_CENTS=
# VIDEO_MAX_CONCURRENT_JOBS=
VIDEO_CONFIRM_ENABLED=false
VIDEO_PROVIDER_SUBMIT_ENABLED=false
VIDEO_PROVIDER_QUERY_ENABLED=false
VIDEO_RESULT_INGEST_ENABLED=false
# Exact HTTPS origins for provider result downloads, e.g. ["https://media.example.com"].
# VIDEO_RESULT_ALLOWED_ORIGINS_JSON=
# Keep both gates false until the polling, ingestion, reconciliation and budget
# settlement workers have been verified against the actual account contract.

# Image generation is independently gated. 1K/2K/4K prices are stored in the
# versioned image quote contract; values here control only local quota/workers.
# IMAGE_PROJECT_BUDGET_CENTS=
# IMAGE_MAX_CONCURRENT_JOBS=
IMAGE_CONFIRM_ENABLED=false
IMAGE_PROVIDER_SUBMIT_ENABLED=false
IMAGE_RESULT_INGEST_ENABLED=false
# Exact HTTPS origin(s) returned by the image provider for result downloads.
# IMAGE_RESULT_ALLOWED_ORIGINS_JSON=
